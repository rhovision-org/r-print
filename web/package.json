{
  "name": "rprint-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:serve": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e:fixture": "playwright test --project=fixture-chromium --project=fixture-mobile",
    "test:e2e:live": "playwright test --project=live-chromium --workers=1",
    "wasm:build": "node scripts/build-wasm.mjs web",
    "wasm:node": "node scripts/build-wasm.mjs nodejs",
    "test:wasm": "node tests/wasm-smoke.mjs",
    "test:live": "tsx tests/live-client.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
